#!/usr/bin/env bash
# List all active AI coding sessions in tmux and switch to one

STANDALONE=false
if [[ "$1" == "--standalone" ]]; then
  STANDALONE=true
  shift
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  cat <<'HELP'
ai-coding-sessions — list and switch between AI coding agent sessions in tmux

Usage: ai-coding-sessions [--help | --install]

Options:
  --help, -h       Show this help
  --install        Add tmux keybinding (prefix + a) to tmux.conf

Tmux setup:
  Run `ai-coding-sessions --install` to automatically add the keybinding,
  or manually add this line to your tmux.conf:

    bind-key a display-popup -E -w 90 -h 15 "ai-coding-sessions"

  Then reload: tmux source-file ~/.config/tmux/tmux.conf

Adding new agents:
  Edit the AGENTS array at the top of this script.
  Format: "process_name:display_name"

  - process_name: value from `ps -eo comm=` when the agent runs
  - display_name: label shown in the AGENT column
  - Multiple process names can share a display name

  Finding the process name:
    1. Start the agent in a tmux pane
    2. Run: ps -eo pid=,comm= | grep <agent-name>
    3. Use the comm column value

  Example — adding aider:
    AGENTS+=( "aider:aider" )
HELP
  exit 0
fi

if [[ "$1" == "--install" ]]; then
  script_path="$(realpath "$0")"
  binding="bind-key a display-popup -E -w 90 -h 15 \"$script_path\""

  # Find tmux.conf
  for conf in ~/.config/tmux/tmux.conf ~/.tmux.conf; do
    [[ -f "$conf" ]] && tmux_conf="$conf" && break
  done

  if [[ -z "$tmux_conf" ]]; then
    echo "No tmux.conf found. Create one at ~/.config/tmux/tmux.conf or ~/.tmux.conf"
    exit 1
  fi

  if grep -qF 'ai-coding-sessions' "$tmux_conf" 2>/dev/null; then
    echo "Already installed in $tmux_conf"
  else
    printf '\n# AI coding session switcher\n%s\n' "$binding" >> "$tmux_conf"
    echo "Added keybinding to $tmux_conf"
  fi

  # Reload if tmux is running
  if tmux info &>/dev/null; then
    tmux source-file "$tmux_conf"
    echo "Reloaded tmux config. Press prefix + a to use."
  else
    echo "Restart tmux or run: tmux source-file $tmux_conf"
  fi
  exit 0
fi

# --- Configure agents here ---
# Format: "process_name:display_name" (one per line)
# process_name = what shows in `ps`, display_name = what you see in the list
AGENTS=(
  "claude:claude"
  "claude-code:claude"
  "codex:codex"
  "opencode:opencode"
)
# -----------------------------

if ! tmux info &>/dev/null; then
  echo "tmux is not running."
  exit 1
fi

# Build lookup from config
declare -A comm_to_agent
ps_pattern=""
for entry in "${AGENTS[@]}"; do
  IFS=':' read -r proc name <<< "$entry"
  comm_to_agent[$proc]="$name"
  ps_pattern="${ps_pattern:+$ps_pattern|}^${proc}$"
done

# Single tmux call: grab pane pid, target, window name, AND cwd
declare -A pane_map pane_cwd
while IFS='|' read -r target pid wname cwd; do
  pane_map[$pid]="$target|$wname"
  pane_cwd[$pid]="$cwd"
done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}|#{pane_pid}|#{window_name}|#{pane_current_path}')

# Single ps call: grab ALL pid->ppid mappings + identify AI processes
declare -A ppid_map
declare -a ai_entries=()
while read -r pid ppid comm; do
  ppid_map[$pid]=$ppid
  [[ -n "${comm_to_agent[$comm]}" ]] && ai_entries+=("$pid $comm")
done < <(ps -eo pid=,ppid=,comm= 2>/dev/null)

# Walk parent chains in-memory (zero subprocess calls)
declare -A found
for entry in "${ai_entries[@]}"; do
  read -r apid comm <<< "$entry"
  agent="${comm_to_agent[$comm]}"
  p=$apid
  depth=0
  while [[ -n "$p" && "$p" -gt 1 && $depth -lt 30 ]]; do
    if [[ -n "${pane_map[$p]}" && -z "${found[$p]}" ]]; then
      found[$p]="$agent"
      break
    fi
    p="${ppid_map[$p]}"
    ((depth++))
  done
done

# Build final list (no subprocess calls — cwd already cached)
mapfile -t panes < <(
  for pid in "${!found[@]}"; do
    agent="${found[$pid]}"
    IFS='|' read -r target wname <<< "${pane_map[$pid]}"
    dir=$(basename "${pane_cwd[$pid]}" 2>/dev/null || echo "?")
    echo "$target|$wname|$dir|$agent"
  done | sort
)

if [[ ${#panes[@]} -eq 0 ]]; then
  echo "No active AI sessions found."
  exit 0
fi

truncate() { local s="$1" max="$2"; [[ ${#s} -gt $max ]] && echo "${s:0:$((max-1))}…" || echo "$s"; }

# Detect current pane (only works inside tmux)
current=""
[[ -n "$TMUX" ]] && current=$(tmux display-message -p '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)

echo "Active AI sessions:"
echo ""
printf "    %-18s %-10s %-18s %s\n" "PANE" "AGENT" "WINDOW" "DIR"
printf "    %-18s %-10s %-18s %s\n" "──────────────────" "──────────" "──────────────────" "──────────────"
for i in "${!panes[@]}"; do
  IFS='|' read -r target wname dir agent <<< "${panes[$i]}"
  wname=$(truncate "$wname" 20)
  dir=$(truncate "$dir" 20)
  marker=" "
  [[ "$target" == "$current" ]] && marker="*"
  printf " %s%d) %-18s %-10s %-18s %s\n" "$marker" "$((i+1))" "$target" "$agent" "$wname" "$dir"
done

max=${#panes[@]}
echo ""
printf "Select (1-%d) or q: " "$max"

# Read single keypress without waiting for Enter
read -rsn1 choice
echo "$choice"

[[ "$choice" == "q" || -z "$choice" ]] && exit 0

# For 10+ sessions, allow a second digit
if [[ "$choice" =~ ^[0-9]$ && $max -ge 10 ]]; then
  read -rsn1 -t 0.5 second
  [[ "$second" =~ ^[0-9]$ ]] && choice="${choice}${second}"
fi

if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= max )); then
  target="${panes[$((choice-1))]%%|*}"
  session="${target%%:*}"
  if [[ "$STANDALONE" == false && -n "$TMUX" ]]; then
    tmux switch-client -t "$target" 2>/dev/null || tmux select-window -t "$target" 2>/dev/null
    tmux select-pane -t "$target" 2>/dev/null
  else
    # Switch the ghostty tmux client to the target session and select the right window/pane
    read -r client_tty < <(tmux list-clients -F '#{client_tty}' 2>/dev/null | head -1)
    if [[ -n "$client_tty" ]]; then
      tmux switch-client -c "$client_tty" -t "$session" 2>/dev/null
      tmux select-window -t "$target" 2>/dev/null
      tmux select-pane -t "$target" 2>/dev/null
    fi
  fi
else
  echo "Invalid selection."
  exit 1
fi
