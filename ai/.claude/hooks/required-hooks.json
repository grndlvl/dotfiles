{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.dotfiles/ai/.claude/hooks/tmux-window-title.py",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.dotfiles/ai/.claude/hooks/tmux-window-title.py",
          "timeout": 5
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.dotfiles/ai/.claude/hooks/tmux-window-title.py",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "~/.dotfiles/ai/.claude/hooks/smart-notify.sh",
          "timeout": 5
        }
      ]
    }
  ],
  "Notification": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "~/.dotfiles/ai/.claude/hooks/smart-notify.sh permission",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.dotfiles/ai/.claude/hooks/tmux-window-title.py",
          "timeout": 5
        }
      ]
    }
  ]
}
